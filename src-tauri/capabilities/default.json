{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for the main window",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "opener:default",
    "dialog:default",
    "fs:allow-read-dir",
    "fs:allow-read-file",
    "fs:allow-exists",
    "fs:allow-write-file",
    "fs:allow-mkdir",
    {
      "identifier": "fs:scope",
      "allow": [{ "path": "$APPDATA" }, { "path": "$APPDATA/**" }]
    },
    {
      "identifier": "http:default",
      "allow": [
        { "url": "https://*/*" },
        { "url": "https://*" },
        { "url": "https://itunes.apple.com/*" },
        { "url": "https://*.mzstatic.com/*" },
        { "url": "https://www.youtube.com/*" },
        { "url": "https://*.youtube.com/*" },
        { "url": "https://*.ytimg.com/*" },
        { "url": "https://i.ytimg.com/*" },
        { "url": "https://img.youtube.com/*" },
        { "url": "https://api.deezer.com/*" },
        { "url": "https://*.dzcdn.net/*" }
      ]
    }
  ]
}
